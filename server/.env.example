# Optional. Without a key the app still works (local keyword retrieval, extractive answers).
# With a key you get semantic embeddings + generated answers.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
PORT=3001

